# Cryptone V4.5 — Environment Variables
# Local: copy to .env
# GitHub Actions: Settings → Secrets and variables → Actions → New repository secret

# ========== WAJIB untuk --live ==========
GEMINI_API_KEY=
CRYPTONE_TELEGRAM_BOT_TOKEN=
CRYPTONE_OPERATOR_CHAT_ID=
CRYPTONE_USER_CHAT_ID=

# ========== Recommended (L5 macro + on-chain) ==========
FRED_API_KEY=
ETHERSCAN_API_KEY=
# JSON map label->address, contoh:
# CRYPTONE_EXCHANGE_WALLETS={"binance_hot":"0xF977814e90dA44bFA03b6295A0616a897441aceC"}

# ========== Runtime (opsional, ada default di yml) ==========
CRYPTONE_DB_PATH=./data/cryptone_v45.db
CRYPTONE_CYCLE_INTERVAL_SEC=300
CRYPTONE_MAX_RUNTIME_SEC=19800
CRYPTONE_AUTO_BOOTSTRAP_DAYS=14
CRYPTONE_LOG_LEVEL=INFO
# CRYPTONE_PINNED_SYMBOLS=
# CRYPTONE_MINUTES_TO_NEXT_MACRO=
