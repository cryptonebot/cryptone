# ============================================================
# Cryptone V4.5 — Local Environment Variables
# Copy file ini ke .env lalu isi value-nya.
# JANGAN commit file .env ke Git.
# ============================================================

# ========== WAJIB untuk --live ==========
GEMINI_API_KEY=ISI_API_KEY_GEMINI_DISINI
CRYPTONE_TELEGRAM_BOT_TOKEN=ISI_BOT_TOKEN_DARI_BOTFATHER
CRYPTONE_OPERATOR_CHAT_ID=ISI_CHAT_ID_OPERATOR
CRYPTONE_USER_CHAT_ID=ISI_CHAT_ID_USER

# ========== Recommended (L5 macro + on-chain Flow Agent) ==========
FRED_API_KEY=ISI_FRED_API_KEY
ETHERSCAN_API_KEY=ISI_ETHERSCAN_API_KEY
# CryptoPanic API paid since Apr 2026 — skip. L5 news = multi-RSS (built-in).
# CRYPTOPANIC_API_KEY=

# Exchange hot wallets (JSON label→address). WAJIB bareng ETHERSCAN_API_KEY.
# Untuk GitHub Secret: paste SATU BARIS JSON (tanpa newline).
CRYPTONE_EXCHANGE_WALLETS={"binance_14":"0x28C6c06298d514Db089934071355E5743bf21d60","binance_8":"0xF977814e90dA44bFA03b6295A0616a897441aceC","binance_17":"0x56Eddb7aa87536c09CCc2793473599fD21A8b17F","coinbase_1":"0x71660c4005BA85c37ccec55d0C4493E66Fe775d3","coinbase_hot":"0xa9d1e08c7793af67e9d92fe308d5697fb81d3e43","bybit_hot":"0xf89d7b9c864f589bbf53a82105107622b35eaa40"}

# ========== Runtime (opsional) ==========
CRYPTONE_DB_PATH=./data/cryptone_v45.db
CRYPTONE_CYCLE_INTERVAL_SEC=300
CRYPTONE_MAX_RUNTIME_SEC=19800
CRYPTONE_AUTO_BOOTSTRAP_DAYS=14
CRYPTONE_LOG_LEVEL=INFO

# Mode pengiriman: "active" = kirim semua sinyal, "quiet"/default = hanya sinyal penting
# CRYPTONE_DELIVERY_MODE=active

# Aktifkan jam tenang (tidak kirim notif jam tertentu)
# CRYPTONE_QUIET_HOURS=1

# Símbol yang wajib dipantau (pisahkan dengan koma)
# CRYPTONE_PINNED_SYMBOLS=BTCUSDT,ETHUSDT

# ========== Macro Event Calendar (§V.3 #12) — L6 veto blackout ==========
# JSON list event high-impact (UTC). Dipakai untuk veto entry sebelum event.
# CRYPTONE_MACRO_EVENTS=[{"name":"FOMC","at":"2026-09-30T18:00:00Z","impact":"high"},{"name":"CPI","at":"2026-10-10T12:30:00Z","impact":"high"}]

# Override manual: menit menuju event macro berikutnya
# CRYPTONE_MINUTES_TO_NEXT_MACRO=
